diff --git a/packages/client/ui-primitives/tests/markdown-inline-directives.client.spec.tsx b/packages/client/ui-primitives/tests/markdown-inline-directives.client.spec.tsx
new file mode 100644
index 000000000..903a4cd8d
--- /dev/null
+++ b/packages/client/ui-primitives/tests/markdown-inline-directives.client.spec.tsx
@@ -0,0 +1,84 @@
+// @vitest-environment jsdom
+// Inline directives are an owner-supplied vocabulary over prose text runs.
+// The renderer parses `:name{key="value"}` and nothing else, so these arms
+// pin what it hands the resolver and what it does with every answer it gets.
+import { cleanup, render } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { MarkdownText } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { MarkdownInlineDirectives } from '@deepseek-ai/dsh-client-ui-primitives'
+
+afterEach(cleanup)
+
+/** Resolve only `mark`, rendering its index; every other name declines. */
+const marks: MarkdownInlineDirectives = {
+  resolve: (name, attributes) => name === 'mark'
+    ? <b data-mark={attributes.index}>{attributes.index}</b>
+    : undefined,
+}
+
+describe('markdown inline directives', () => {
+  it('replaces a resolved run and keeps the surrounding text', () => {
+    const view = render(
+      <MarkdownText text={'before :mark{index="2"} after'} inlineDirectives={marks} />,
+    )
+
+    expect(view.getByText('2').getAttribute('data-mark')).toBe('2')
+    expect(view.container.textContent).toBe('before 2 after')
+  })
+
+  it('resolves several runs in one text node, in author order', () => {
+    const view = render(
+      <MarkdownText text={':mark{index="1"} then :mark{index="3"}'} inlineDirectives={marks} />,
+    )
+
+    expect([...view.container.querySelectorAll('[data-mark]')].map(node => node.textContent))
+      .toEqual(['1', '3'])
+  })
+
+  it('keeps a declined directive as the literal text the author wrote', () => {
+    const view = render(
+      <MarkdownText text={'see :other{index="1"} here'} inlineDirectives={marks} />,
+    )
+
+    expect(view.container.querySelector('[data-mark]')).toBeNull()
+    expect(view.container.textContent).toBe('see :other{index="1"} here')
+  })
+
+  it('parses every quoted attribute and ignores unquoted noise', () => {
+    const resolve = vi.fn(() => <i>ok</i>)
+    render(
+      <MarkdownText text={':mark{index="2" side="left" bare}'} inlineDirectives={{ resolve }} />,
+    )
+
+    expect(resolve).toHaveBeenCalledWith('mark', { index: '2', side: 'left' })
+  })
+
+  it('leaves prose untouched without a vocabulary, and never scans text with no candidate', () => {
+    const resolve = vi.fn(() => null)
+    const without = render(<MarkdownText text={':mark{index="1"}'} />)
+    expect(without.container.textContent).toBe(':mark{index="1"}')
+
+    render(<MarkdownText text="ordinary prose" inlineDirectives={{ resolve }} />)
+    expect(resolve).not.toHaveBeenCalled()
+  })
+
+  it('stays literal inside a link, where interactive content cannot nest', () => {
+    const view = render(
+      <MarkdownText
+        text={'[label :mark{index="1"}](https://example.com)'}
+        inlineDirectives={marks}
+      />,
+    )
+
+    expect(view.container.querySelector('[data-mark]')).toBeNull()
+    expect(view.container.querySelector('a')?.textContent).toBe('label :mark{index="1"}')
+  })
+
+  it('is a settled-render affordance only, like inline-code file mentions', () => {
+    const view = render(
+      <MarkdownText text={':mark{index="1"}'} streaming inlineDirectives={marks} />,
+    )
+
+    expect(view.container.querySelector('[data-mark]')).toBeNull()
+  })
+})
