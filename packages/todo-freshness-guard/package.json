{
  "name": "dsh-todo-freshness-guard",
  "version": "0.2.0",
  "description": "Remind and block stale tool work until todo_write is reconciled in DeepSeek Harness",
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "todo", "guard", "agent"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamost423/dsh-codex-experience.git",
    "directory": "packages/todo-freshness-guard"
  },
  "bugs": { "url": "https://github.com/lamost423/dsh-codex-experience/issues" },
  "homepage": "https://github.com/lamost423/dsh-codex-experience#readme",
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
